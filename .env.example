# 复制本文件为 .env.local，然后填写。
# .env.local 不要提交到代码库，也不要发给别人。

# DeepSeek 模型密钥。留空时问答会返回「模型尚未连接」，
# 但知识库上传校验、巡检、补回这些功能都不受影响，照样能测。
DEEPSEEK_API_KEY=

# 开发环境的本地数据目录。留空则默认用 site/.local-data。
# 知识库、巡检记录、补回计数都存在这里，删掉这个目录就等于清空重来。
LOCAL_KNOWLEDGE_DIR=

# 多轮对话会话存储的目录。留空则依次退回 LOCAL_KNOWLEDGE_DIR、再退回 site/.local-data，
# 一般不需要单独填——两块数据存在同一个目录下的不同文件里，互不影响。
LOCAL_CONVERSATION_DIR=

# 税务案例库存储的目录。留空则依次退回 LOCAL_KNOWLEDGE_DIR、再退回 site/.local-data，
# 一般不需要单独填，理由同上。
LOCAL_CASE_DIR=

# 用户上传Notice/合同/申报文件的私有存储目录。留空则依次退回 LOCAL_CONVERSATION_DIR、
# LOCAL_KNOWLEDGE_DIR、再退回 site/.local-data，一般不需要单独填。这份数据比知识库
# 敏感（是用户自己的Notice原文），产品规则表要求"只对上传者和有审计授权的超级管理员
# 可见；不得进入公共知识库"——现在还没有独立的审计查看入口，如实记一下。
LOCAL_ATTACHMENT_DIR=

# Notice原文喂给模型提取事实之前的截断长度（字符数），避免特别长的Notice把上下文占满。
# 没有实测调过，是估的初始值。
NOTICE_MAX_CHARS=20000

# 图片版Notice（拍照/截图）的OCR识别，用腾讯云「通用印刷体识别」（2026-09-15应用户
# 要求加的，我这边没有真实账号测过，见 notice-extract.ts 文件头的诚实说明）。
# 两个密钥都要在腾讯云控制台开通"文字识别OCR"服务后自己生成，不填的话图片上传会
# 直接提示"暂不支持"，不影响PDF/Word/纯文本的Notice解析。
# 计费：每月前1000次免费，超出后阶梯计费，1万次以内¥0.15/次、1万-10万次¥0.10/次、
# 10万次以上¥0.06/次（2026-09价格，以腾讯云官方定价页为准：
# https://cloud.tencent.com/document/product/866/17619 ）。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 腾讯云OCR的地域参数，没有特殊要求不用改。
TENCENTCLOUD_OCR_REGION=ap-guangzhou
# 图片上传大小上限（字节）。腾讯云官方文档写的限制是"Base64编码后不超过7MB"，
# 这里按编码前的原始文件大小留了余量估算，没有拿真实图片实测过，是估的初始值。
OCR_MAX_IMAGE_BYTES=5242880

# 生产环境的 PostgreSQL 连接串。本地测试不需要填。
DATABASE_URL=

# 向量检索（混合检索的"向量"那一路）。留空则自动退回纯关键词检索，功能不受影响。
# 默认用腾讯云 TokenHub 的 kinfra 文本向量模型（OpenAI 兼容接口）。
# 密钥在 TokenHub 控制台获取：https://console.cloud.tencent.com/tokenhub/apikey
# 模型可选 kinfra-text-embedding-4b（2560维，检索质量更好）
#        或 kinfra-text-embedding-0.6b（1024维，更便宜）
# 换模型后向量空间不通用，必须在总览页点"全部重算"。
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://tokenhub.tencentmaas.com/v1
EMBEDDING_MODEL=kinfra-text-embedding-4b
EMBEDDING_DIMENSION=2560
# 应急开关：填 off 可立刻停用向量检索、退回纯关键词，不需要改代码或回滚。
HYBRID_RETRIEVAL=on

# 二次检索闭环：第一轮证据拿到后，先让模型指出"还缺哪些义务"，再补检索一轮。
# 治的是"法律要件只能在看到证据之前靠猜"这个根因（实测漏过 Section 42、PAS-3）。
# 代价是每次问答多一次模型调用，延迟约多 5-10 秒。设为 off 可关闭，关闭后行为与加这个功能前一致。
SECOND_PASS_RETRIEVAL=on

# 证据主题相关性校验：MANDATORY步骤的结论文本 vs 它引用的证据算向量相似度，
# 明显不相关的直接过滤掉，中间地带升级到模型判断是否真的蕴含这条结论。
# 治的是"原句逐字对得上、但主题完全不相关"这类比没有引用更危险的失败
# （线上事故：PAN/TAN的结论挂了《生产者公司组建》条款，quote-check原句核验照样判VERIFIED）。
# 依赖 EMBEDDING_API_KEY，没配置向量密钥时这道检查整体跳过。
# 设为 off 可关闭，关闭后行为与加这道检查前一致。
RELEVANCE_CHECK=on
# 两条阈值没有实测的中英跨语言相似度分布支撑，是估的初始值，上线后要用真实案例调。
# 相似度 >= HIGH 判相关放行；< LOW 判不相关直接过滤；中间地带才升级到模型判断。
RELEVANCE_LOW_THRESHOLD=0.3
RELEVANCE_HIGH_THRESHOLD=0.55

# Indian Kanoon 判例数据库API。密钥在 api.indiankanoon.org 注册后自己生成
# （共享Token方式，不是公私钥那种）。按官方定价：搜索每次₹0.50，取文档全文每次₹0.20，
# 注册送₹500测试额度。
# 两处地方用到同一个变量名，但是两回事：
#   1. scripts/case-extract.mjs、scripts/case-monitor.mjs——本地脚本，你自己电脑上跑，
#      填在你本机的环境变量里，不影响服务器。
#   2. lib/server/case-search.ts 阶段三判例检索的实时兜底——这是服务器在生产环境里
#      直接花钱调用，要在服务器的 .env.local 里单独填一份同名变量才会生效，
#      本机脚本那份token不会自动同步过去。没填的话实时兜底自动跳过，不报错，
#      问答只用本地案例库的结果（案例库还没收录相关案例时，判例区块就不会出现）。
INDIANKANOON_API_TOKEN=

# 阶段三：问答链路里的判例检索总开关。填 off 可以整体关掉（本地+实时都不查），
# 不需要改代码。默认开启，但实际会不会触发还要看问题里有没有判例相关信号词
# （shouldSearchCases()），不是每次问答都会去查。
CASE_SEARCH=on
# 本地案例库没查到相关案例时，要不要进一步花钱实时查 Indian Kanoon 兜底。
# 填 off 可以只用本地案例库、不花钱查实时的；即使不填 off，没配置上面的
# INDIANKANOON_API_TOKEN 时也会自动不触发，不会报错。
CASE_LIVE_FALLBACK=on
# 本地案例检索的两道阈值，都是估的初始值，没有实测调过：
#   关键词重合度低于这个值，不算"本地有相关案例"（0~1，纯词面重合比例）
CASE_SEARCH_MIN_SCORE=0.18
#   配置了 EMBEDDING_API_KEY 时，向量相似度低于这个值也不算数
CASE_SEARCH_SIMILARITY_THRESHOLD=0.35
# 本地案例库至少要拿出几条才算"够用"。不足这个数会自动补查 Indian Kanoon，
# 用现查的判例把缺口填满（旧行为是本地一条都没有才兜底）。
CASE_SEARCH_MIN_LOCAL=3
# 现查回来的判例是否后台自动提炼成九字段、存进案例库。
# 需要 INDIANKANOON_API_TOKEN + DEEPSEEK_API_KEY 都配置了才生效。
CASE_AUTO_CACHE=on
# 自动缓存的案例是否直接发布。默认关——机器提炼的记录没人审过，
# 不该直接进问答检索范围。管理员在后台点"发布"即可。
CASE_AUTO_CACHE_PUBLISH=off
# Income-tax Act, 2025 的施行日。到这天起，问"现在"的问题不再引用 1961 年所得税法。
# 留这个旋钮是为了印度政府万一推迟施行时不用改代码重新部署。
INCOME_TAX_ACT_2025_EFFECTIVE_FROM=2026-04-01

# 追问案例细节现查现答（用户明确要求要这个模式，2026-09-11）：用户对已展示的案例
# 继续追问九字段模板里没有的细节时（"涉案金额是多少"这类），现查判决书全文作答，
# 不是每次追问都会触发——只在"延续上一话题"+"上一轮确实展示过案例"+"这次问的
# 像是模板外细节"同时成立时才会跑。成本和延迟都比普通问答高：
#   1）一次 Indian Kanoon Document API 全文下载（约₹0.20/次，用上面同一个
#      INDIANKANOON_API_TOKEN，没配置这个token时本功能自动不触发，不会报错）；
#   2）一次 DeepSeek 调用，让模型只依据现查回来的原文作答，延迟大约再加5-15秒；
#   3）回答里的关键细节要核验模型给的原句是否真的出自原文（逻辑同 quote-check.ts），
#      核验不过就不展示具体内容，只提示"未能核验，建议自己点开原文核对"。
# 填 off 可以整体关掉，关闭后追问模板外细节会照旧走知识库问答主流程
# （大概率答成"无法确认"，但不会现查现答）。
CASE_DETAIL_LOOKUP=on
# 现查回来的判决书原文喂给模型前的截断长度（字符数），避免太长的判决书占满上下文。
CASE_DETAIL_MAX_CHARS=40000

# 判例综述（2026-09-16加）：把检索到的几份判例**横向归纳成风险主题**再展示，
# 而不是把案例库里存的九字段原样倒给用户（用户反馈原样展示"无用、零散"）。
# 输出结构：风险主题簇（挑战+实证+法院倾向）、应对要点、案例索引。
# 只在这一轮真的检索到判例时才触发，不是每个问题都会跑；每次多一次模型调用，
# 延迟约多 3-8 秒。生成失败、或生成内容没通过核验时自动退回简短的案例列表，
# 不影响主答案。填 off 可关闭。
# 核验是确定性的（同 quote-check 的思路）：综述里提到的 docid 必须是这次真的
# 检索到的案例，提到的金额必须能在案例记录原文里逐字找到，否则那一条直接丢弃。
CASE_DIGEST=on
# 每份案例送进模型归纳时的截断长度（字符数）。调大能让归纳更完整，代价是成本和延迟。
CASE_DIGEST_PER_CASE_CHARS=6000

# Notice原文节选送进回答生成时的截断长度（字符数）。比 NOTICE_MAX_CHARS 小一截：
# 提取事实可以多喂一点，但节选要和证据一起进生成提示词，占太多会挤掉证据。
# 调大能让模型看到更完整的Notice（回答更具体），代价是每次问答的成本和延迟上升。
NOTICE_EXCERPT_CHARS=3000

# 问答链路诊断日志（2026-09-15加）。默认开启，每次问答在服务器日志里打两三行：
#   [trace 请求ID] cache=HIT/MISS topic=... attachments=N noticeFactFields=[...]
#   [trace 请求ID] query_en="..." elements=[...]
#   [trace 请求ID] evidence=["E1|法律名|条号", ...]
# 用途：出现"答非所问"时，直接分辨是①命中了旧缓存、②检索词就跑偏了、
# ③检索词对但命中的条文不对、还是④证据都对只是生成阶段没用好——
# 不用再靠猜（2026-09-15连着猜错两次根因的直接教训）。
# 只打派生出来的检索词和命中的条文标识，以及Notice提取到了哪几个**字段名**，
# 不打问题原文、不打字段内容、不打上传文件的任何内容——符合产品规则表
# "不在普通日志中记录用户上传文件全文"的要求。填 off 可以关掉。
ANSWER_TRACE=on

# 管理后台（/admin 和 /api/admin/*）的登录账号密码。
# 不填的话，管理后台会直接拒绝所有访问（而不是不设防），本地测试也需要填。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 用户账号与会话的存储目录（2026-09-17加）。留空则依次退回 LOCAL_KNOWLEDGE_DIR、
# 再退回 site/.local-data。里面存的是用户邮箱、**密码的scrypt哈希**（不是明文）、
# 会话令牌的SHA-256（不是令牌本身）和每月额度计数。
# 这个文件比知识库敏感得多：泄露了虽然拿不到明文密码、也冒充不了登录，
# 但会暴露有哪些人注册过。备份和迁移服务器时要和 .env.local 一样小心对待。
LOCAL_USER_DIR=

# 注册验证码的 HMAC 密钥。留空时复用 TENCENT_SECRET_KEY（验证码本身仍不会落盘）；
# 生产环境建议另填一串随机字符，便于日后独立轮换腾讯云 API 密钥。
AUTH_VERIFICATION_SECRET=

# 腾讯云 SES 中审核通过的「账号安全验证码」模板 ID。注册与重置密码共用；模板源文件在仓库根目录
# `邮件模板/注册验证码邮件.html`，变量名是 {{code}} 和 {{minutes}}；不要复用截止日提醒模板。
TENCENT_SES_REGISTRATION_TEMPLATE_ID=

# 不限次数的测试账号（邮箱，逗号分隔）。**测试用的后门，不是产品功能**——
# 名单里的账号可以无限次消耗 DeepSeek 和 Indian Kanoon 的调用额度，那是真花钱的。
# 测完把这一行删掉、pm2 restart 即可恢复正常计费，不用重新部署代码。
# 别拿它当客户福利，客户该做的是升级套餐。
QUOTA_UNLIMITED_EMAILS=

# 游客试用的第二把锁：每个出口 IP 每天能试问几次（服务端计数，脚本不带 Cookie 也躲不开）。
# 比 Cookie 那把锁（1次/浏览器）松，因为公司/学校/基站是共享出口 IP，卡死了会误伤真实用户。
ANONYMOUS_IP_DAILY_LIMIT=5
# IP 哈希用的盐。只存 SHA-256(IP+盐)，不存 IP 原文。生产环境请改成一串随机字符。
ANONYMOUS_TRIAL_SALT=
